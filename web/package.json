    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^25.8.0",
    "i18next-resources-to-backend": "^1.2.1",
    "js-yaml": "^5.2.3",
    "jsonrepair": "^3.13.2",
    "jspdf": "^4.2.1",
    "katex": "^0.16.45",

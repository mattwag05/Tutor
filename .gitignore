# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# ============================================
# Other Python Tools
# ============================================
# Celery
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# ============================================
# Profiling
# ============================================
*.prof
*.pstats

# ============================================
# Database Files
# ============================================
*.db
*.sqlite
*.sqlite3

# ============================================
# Compressed Files
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ============================================
# Reference Papers (large binary files)
# ============================================
# Keep structure but ignore large PDFs in reference_papers
# question_agents/reference_papers/**/*.pdf

# ============================================
# Audio/Video Output (TTS generated)
# ============================================
*.mp3
*.wav
*.ogg
!demo/*.mp4

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key

# Claude Code runtime artifacts
.claude/scheduled_tasks.lock

# pnpm content-addressed store (used during lockfile regen)
.pnpm-store/
**/.pnpm-store/

# Service worker build output (generated by serwist during next build)
web/public/sw.js
web/public/sw.js.map
web/public/workbox-*.js
web/public/workbox-*.js.map

# Python MANIFEST is a dist artifact — don't shadow web/lib/ai/manifest/ or API routes
!web/lib/ai/manifest/
!web/app/api/settings/manifest/

# iCloud Drive duplicates "<name> 2", "<name> 3" etc. on synced trees.
# Untracked artifacts; gitignore them so `git add -A` can't accidentally
# commit a stale copy. CLAUDE.md gotcha #26 covers cleanup + tsc filter.
* 2
* 2.ts
* 2.tsx
* 2.js
* 2.py
* 2.json
* 2.md
